<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="ChromiatorMainShell" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style><class name="chromiator-root"/></style>
    <child>
      <object class="GtkHeaderBar" id="header">
        <property name="show-title-buttons">true</property>
        <child type="title">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="valign">center</property>
            <child><object class="GtkLabel"><property name="label">Chromiator</property><style><class name="title"/></style></object></child>
            <child><object class="GtkLabel"><property name="label">Voronoi color studio</property><style><class name="subtitle"/><class name="dim-label"/></style></object></child>
          </object>
        </child>
        <child type="start"><object class="GtkButton" id="open_button"><property name="icon-name">document-open-symbolic</property><property name="tooltip-text">Open image or project (Ctrl+O)</property></object></child>
        <child type="start"><object class="GtkSeparator" id="file_spacer"><property name="orientation">vertical</property></object></child>
        <child type="start"><object class="GtkButton" id="save_button"><property name="icon-name">document-save-symbolic</property><property name="tooltip-text">Save project (Ctrl+S)</property><property name="sensitive">false</property></object></child>
        <child type="start"><object class="GtkSeparator" id="history_spacer"><property name="orientation">vertical</property></object></child>
        <child type="start"><object class="GtkButton" id="undo_button"><property name="icon-name">edit-undo-symbolic</property><property name="tooltip-text">Undo document change (Ctrl+Z)</property><property name="sensitive">false</property></object></child>
        <child type="start"><object class="GtkButton" id="redo_button"><property name="icon-name">edit-redo-symbolic</property><property name="tooltip-text">Redo document change (Ctrl+Shift+Z)</property><property name="sensitive">false</property></object></child>
        <child type="end"><object class="GtkMenuButton" id="document_menu"><property name="icon-name">open-menu-symbolic</property><property name="tooltip-text">Document Menu</property></object></child>
        <child type="end"><object class="GtkToggleButton" id="sidebar_button"><property name="icon-name">sidebar-show-symbolic</property><property name="tooltip-text">Show adjustments</property><property name="active">true</property></object></child>
        <child type="end"><object class="GtkButton" id="export_button"><property name="tooltip-text">Export full-resolution image (Ctrl+Shift+E)</property><property name="sensitive">false</property><property name="label">Export</property></object></child>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="page_stack">
        <property name="hexpand">true</property><property name="vexpand">true</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="child">
                  <object class="GtkBox" id="welcome_content">
                    <property name="orientation">vertical</property><property name="spacing">0</property>
                    <property name="hexpand">true</property><property name="valign">start</property>
                    <child><object class="GtkBox" id="welcome_media"><property name="orientation">vertical</property></object></child>
                    <child>
                      <object class="GtkFlowBox">
                        <property name="selection-mode">none</property><property name="homogeneous">true</property>
                        <property name="min-children-per-line">1</property><property name="max-children-per-line">2</property>
                        <property name="column-spacing">20</property><property name="row-spacing">20</property>
                        <property name="margin-top">20</property><property name="margin-bottom">20</property><property name="margin-start">20</property><property name="margin-end">20</property>
                        <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="valign">fill</property><style><class name="chromiator-startup-panel"/></style>
                          <child><object class="GtkLabel"><property name="label">About Chromiator</property><property name="xalign">0</property><style><class name="title-2"/></style></object></child>
                          <child><object class="GtkLabel"><property name="label">Chromiator is an artist-directed perceptual color-space partitioning and remapping application. It uses editable Voronoi sites in a perceptual color space to simplify, segment, recolor, and blend an image's color structure while preserving its spatial structure.</property><property name="wrap">true</property><property name="xalign">0</property><property name="max-width-chars">48</property></object></child>
                          <child><object class="GtkButton" id="welcome_open"><property name="label">Start New Project</property><property name="tooltip-text">Choose a source image to begin a new project</property><style><class name="suggested-action"/></style></object></child>
                          <child><object class="GtkButton" id="welcome_project"><property name="label">Browse Projects...</property></object></child>
                          <child><object class="GtkButton" id="welcome_example"><property name="label">Try Spectrum Example</property><style><class name="flat"/></style></object></child>
                        </object></child>
                        <child><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property><property name="valign">fill</property><style><class name="chromiator-startup-panel"/></style>
                          <child><object class="GtkBox"><property name="spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Recent projects</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="title-2"/></style></object></child>
                            <child><object class="GtkButton" id="welcome_recent_clear"><property name="label">Clear list</property><property name="tooltip-text">Clear recent-project history without deleting any files</property><style><class name="flat"/></style></object></child>
                          </object></child>
                          <child><object class="GtkScrolledWindow"><property name="hscrollbar-policy">never</property><property name="vscrollbar-policy">automatic</property><property name="min-content-height">250</property><property name="max-content-height">320</property><property name="propagate-natural-height">true</property><property name="vexpand">true</property>
                            <property name="child"><object class="GtkBox" id="welcome_recent"><property name="orientation">vertical</property><property name="spacing">6</property></object></property>
                          </object></child>
                        </object></child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">document</property>
            <property name="child">
              <object class="GtkPaned" id="workspace_split">
                <property name="orientation">horizontal</property><property name="wide-handle">true</property>
                <property name="position">820</property>
                <property name="resize-start-child">true</property><property name="resize-end-child">false</property>
                <property name="shrink-start-child">true</property><property name="shrink-end-child">false</property>
                <child>
                  <object class="GtkBox" id="viewer"><property name="orientation">vertical</property><property name="spacing">8</property><property name="hexpand">true</property><property name="vexpand">true</property><style><class name="chromiator-viewer"/></style>
                    <child><object class="GtkDrawingArea" id="canvas"><property name="hexpand">true</property><property name="vexpand">true</property><property name="content-width">320</property><property name="content-height">240</property><property name="focusable">true</property><style><class name="chromiator-canvas"/><class name="creative-focus"/></style></object></child>
                    <child><object class="GtkBox" id="comparison_controls"><property name="orientation">horizontal</property><property name="halign">center</property><style><class name="linked"/></style>
                      <child><object class="GtkToggleButton" id="result_mode"><property name="label">Result</property><property name="active">true</property></object></child>
                      <child><object class="GtkToggleButton" id="split_mode"><property name="label">Split</property><property name="group">result_mode</property></object></child>
                      <child><object class="GtkToggleButton" id="source_mode"><property name="label">Source</property><property name="group">result_mode</property></object></child>
                    </object></child>
                  </object>
                </child>
                <child><object class="GtkScrolledWindow" id="inspector_scroll"><property name="hscrollbar-policy">never</property><property name="vscrollbar-policy">automatic</property><property name="min-content-width">280</property><property name="max-content-width">360</property><style><class name="chromiator-inspector"/></style><property name="child"><object class="GtkBox" id="inspector_content"><property name="orientation">vertical</property><style><class name="chromiator-inspector-content"/></style></object></property></object></child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="status_bar"><property name="orientation">horizontal</property><property name="spacing">8</property><style><class name="chromiator-status"/></style>
        <child><object class="GtkLabel" id="status"><property name="label">Ready</property><property name="xalign">0</property><property name="hexpand">true</property><property name="ellipsize">end</property></object></child>
        <child><object class="GtkProgressBar" id="progress"><property name="width-request">180</property><property name="visible">false</property></object></child>
        <child><object class="GtkButton" id="cancel"><property name="label">Cancel</property><property name="visible">false</property></object></child>
        <child><object class="GtkLabel" id="pipeline_status"><property name="label">32-bit float · Linear sRGB</property><property name="xalign">1</property><property name="ellipsize">end</property><style><class name="dim-label"/></style></object></child>
      </object>
    </child>
  </template>
</interface>
